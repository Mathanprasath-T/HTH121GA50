# SyntheticLab Environment Configuration Template
# Copy to .env and configure your keys

# Google Gemini API Key from Google AI Studio (Server-side only, do not expose via VITE_*)
GEMINI_API_KEY=
GEMINI_MODEL=models/gemini-3.5-flash

# Supabase Cloud Database + Storage (Client-safe publishable credentials)
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
